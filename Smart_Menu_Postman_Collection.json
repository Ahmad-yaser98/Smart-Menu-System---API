{
  "info": {
    "name": "Smart Menu System API",
    "description": "مجموعة اختبار كاملة لنظام المطعم الذكي (الكابتن، المطبخ، الكاشير، الإدارة)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.add({key: 'Accept', value: 'application/json'});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "order_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication (التسجيل)",
      "item": [
        {
          "name": "Login (تسجيل الدخول)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    console.log('Token saved automatically!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin@test.com\",\n    \"password\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            }
          }
        },
        {
          "name": "Logout (تسجيل الخروج)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "logout"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Admin Only (للإدارة فقط)",
      "item": [
        {
          "name": "Create New Employee (إنشاء موظف جديد)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"New Waiter\",\n    \"email\": \"newwaiter@test.com\",\n    \"password\": \"12345678\",\n    \"password_confirmation\": \"12345678\",\n    \"role\": \"waiter\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Waiter Flow (دورة الكابتن)",
      "item": [
        {
          "name": "Get Menu (عرض المنيو)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/menu",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "menu"
              ]
            }
          }
        },
        {
          "name": "Create Order (طلب جديد)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.order && jsonData.order.id) {",
                  "    pm.collectionVariables.set('order_id', jsonData.order.id);",
                  "}",
                  "if(jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set('order_id', jsonData.data.id);",
                  "}",
                  "if(jsonData.id) {",
                  "    pm.collectionVariables.set('order_id', jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"table_id\": 1,\n    \"items\": [\n        {\n            \"menu_item_id\": 1,\n            \"quantity\": 2,\n            \"notes\": \"بدون مخلل\"\n        }\n    ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/orders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "orders"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Kitchen Flow (دورة المطبخ)",
      "item": [
        {
          "name": "Get Active Orders (طلبات الشاشة)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/kitchen/orders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "kitchen",
                "orders"
              ]
            }
          }
        },
        {
          "name": "Update Status To Preparing (قيد التحضير)",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"status\": \"preparing\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/kitchen/orders/{{order_id}}/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "kitchen",
                "orders",
                "{{order_id}}",
                "status"
              ]
            }
          }
        },
        {
          "name": "Update Status To Ready (جاهز)",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"status\": \"ready\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/kitchen/orders/{{order_id}}/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "kitchen",
                "orders",
                "{{order_id}}",
                "status"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. Waiter Serves (تسليم الطلب)",
      "item": [
        {
          "name": "Serve Order (تأكيد التسليم للطاولة)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{base_url}}/orders/{{order_id}}/serve",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "orders",
                "{{order_id}}",
                "serve"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "6. Cashier Flow (دورة الكاشير)",
      "item": [
        {
          "name": "Generate Invoice (طباعة الفاتورة)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/invoices/{{order_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "invoices",
                "{{order_id}}"
              ]
            }
          }
        },
        {
          "name": "Pay Invoice (سداد الفاتورة)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"payment_method\": \"cash\",\n    \"amount_paid\": 100.00\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/invoices/{{order_id}}/pay",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "invoices",
                "{{order_id}}",
                "pay"
              ]
            }
          }
        }
      ]
    }
  ]
}